+            target = target_buffer;
+            command = separator + 1;
+        }
+        int result = avfilter_graph_send_command(c->graph, target, command, cmd->arg,
+                                                 &(char){0}, 0, 0);
+        talloc_free(target_buffer);
+        return result >= 0;
