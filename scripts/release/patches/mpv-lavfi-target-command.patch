     switch (cmd->type) {
     case MP_FILTER_COMMAND_TEXT: {
-        return avfilter_graph_send_command(c->graph, "all", cmd->cmd, cmd->arg,
-                                           &(char){0}, 0, 0) >= 0;
+        // A targeted command uses <filter-id>:<option>, e.g. eq5:gain.
+        // Keep mpv's original broadcast semantics when no target is present.
+        const char *target = "all";
+        const char *command = cmd->cmd;
+        char *target_buffer = NULL;
