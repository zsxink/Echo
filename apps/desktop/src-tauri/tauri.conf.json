{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Echo",
  "version": "0.2.0",
  "identifier": "com.zsxink.echo",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Echo",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' cover: http://cover.localhost data:; media-src 'self' cover: data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["mp3"], "mimeType": "audio/mpeg", "name": "MP3 音频", "role": "Viewer" },
      { "ext": ["flac"], "mimeType": "audio/flac", "name": "FLAC 音频", "role": "Viewer" },
      { "ext": ["m4a"], "mimeType": "audio/mp4", "name": "M4A 音频", "role": "Viewer" },
      { "ext": ["ogg", "opus"], "mimeType": "audio/ogg", "name": "Ogg 音频", "role": "Viewer" },
      { "ext": ["wav"], "mimeType": "audio/wav", "name": "WAV 音频", "role": "Viewer" },
      { "ext": ["ape"], "mimeType": "audio/ape", "name": "APE 音频", "role": "Viewer" }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 460 },
        "appPosition": { "x": 170, "y": 225 },
        "applicationFolderPosition": { "x": 550, "y": 225 }
      },
      "files": {
        "Frameworks/libavcodec.dylib": "vendor/libmpv/macos/libavcodec.dylib",
        "Frameworks/libavfilter.dylib": "vendor/libmpv/macos/libavfilter.dylib",
        "Frameworks/libavformat.dylib": "vendor/libmpv/macos/libavformat.dylib",
        "Frameworks/libavutil.dylib": "vendor/libmpv/macos/libavutil.dylib",
        "Frameworks/libmbedcrypto.dylib": "vendor/libmpv/macos/libmbedcrypto.dylib",
        "Frameworks/libmbedtls.dylib": "vendor/libmpv/macos/libmbedtls.dylib",
        "Frameworks/libmbedx509.dylib": "vendor/libmpv/macos/libmbedx509.dylib",
        "Frameworks/libmpv.dylib": "vendor/libmpv/macos/libmpv.dylib",
        "Frameworks/libswresample.dylib": "vendor/libmpv/macos/libswresample.dylib",
        "Frameworks/libswscale.dylib": "vendor/libmpv/macos/libswscale.dylib",
        "Frameworks/libass.9.dylib": "vendor/libmpv/macos/libass.9.dylib",
        "Frameworks/libfreetype.6.dylib": "vendor/libmpv/macos/libfreetype.6.dylib",
        "Frameworks/libfribidi.0.dylib": "vendor/libmpv/macos/libfribidi.0.dylib",
        "Frameworks/libglib-2.0.0.dylib": "vendor/libmpv/macos/libglib-2.0.0.dylib",
        "Frameworks/libgraphite2.3.dylib": "vendor/libmpv/macos/libgraphite2.3.dylib",
        "Frameworks/libharfbuzz.0.dylib": "vendor/libmpv/macos/libharfbuzz.0.dylib",
        "Frameworks/libintl.8.dylib": "vendor/libmpv/macos/libintl.8.dylib",
        "Frameworks/libpcre2-8.0.dylib": "vendor/libmpv/macos/libpcre2-8.0.dylib",
        "Frameworks/libpng16.16.dylib": "vendor/libmpv/macos/libpng16.16.dylib",
        "Frameworks/libunibreak.8.dylib": "vendor/libmpv/macos/libunibreak.8.dylib",
        "Resources/third-party/libmpv/NOTICE.md": "vendor/libmpv/macos/NOTICE.md"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "usr/bin/libmpv.so": "vendor/libmpv/linux/libmpv.so"
        }
      },
      "appimage": {
        "files": {
          "usr/bin/libmpv.so": "vendor/libmpv/linux/libmpv.so"
        }
      }
    }
  }
}
